include LICENSE
include NOTICE
include README.md
include CHANGELOG.md
include scripts/check_release_metadata.py
include scripts/benchmark_tui_responsiveness.py
include scripts/check_tui_terminal.py
recursive-include examples *.md *.py *.yaml
prune examples/bench/runs
prune examples/bench/results
prune examples/rlm-demo/.superqode
global-exclude */.superqode/*
recursive-include src/superqode/data/eval_fixtures *.log
recursive-include src/superqode/data/eval_packs *.yaml
recursive-include src/superqode/systemone/packs *.yaml
include tests/fixtures/gauge-release-policy.json

prune docs/research
exclude scripts/calibrate_local_harnesses.py
exclude scripts/prepare_harness_comparison.py
exclude scripts/validate_harness_routes.py
exclude tests/test_calibration_pack.py
prune tests/fixtures/harness_calibration
