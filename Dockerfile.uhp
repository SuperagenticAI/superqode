# Container image for the SuperQode UHP Core bind (uhp.superqode.dev).
#
# Separate from the root Dockerfile, which is the A2A Cloud Run image.
# Do not point the A2A trigger at this file, and do not point the UHP
# trigger at Dockerfile.
#
# Cloud Run sets PORT. Bind 0.0.0.0 and pass --allow-remote.
# SUPERQODE_UHP_API_KEY must come from Secret Manager. Do not set a
# provider key (GEMINI_API_KEY, GOOGLE_API_KEY, DEEPSEEK_API_KEY, ...)
# on this service: harness turns use the caller's X-Provider-Api-Key header.

FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    SUPERQODE_TELEMETRY=false \
    SUPERQODE_NO_SPLASH=1 \
    SUPERQODE_PROVIDER=google \
    SUPERQODE_MODEL=gemini-flash-latest

WORKDIR /app

COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

COPY pyproject.toml README.md LICENSE NOTICE MANIFEST.in ./
COPY src ./src
COPY deploy/uhp/core.yaml /app/harness.yaml

RUN uv pip install --system --no-cache ".[uhp]"

ENV PORT=8080
EXPOSE 8080

# --api-key is deliberately absent: the option reads SUPERQODE_UHP_API_KEY
# from the environment, and an argument would put the shared bearer in the
# container's process arguments. The bind still refuses to start without it.
CMD exec superqode serve uhp \
    --spec /app/harness.yaml \
    --host 0.0.0.0 \
    --port ${PORT} \
    --allow-remote \
    --provider ${SUPERQODE_PROVIDER} \
    --model ${SUPERQODE_MODEL} \
    --harness-id chrn_superqode_core \
    --working-dir /app
